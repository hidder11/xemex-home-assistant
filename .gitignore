# Alleen broncode, tests en functionele documentatie opnemen.
/*
!/.gitignore
!/README.md
!/requirements-test.txt
!/custom_components/
!/tests/

# Python-caches en lokale instellingen.
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
.env
.env.*
*.log

# PDF-documenten blijven lokaal, ook in bron- en testmappen.
*.[pP][dD][fF]
